  VALUE: SYS-006
- TYPE: File
  VALUE: tools/tui/main.go

[SW_REQUIREMENT]
UID: SWR-016
TITLE: GUI — Sensordaten und GPIO-Steuerung
STATEMENT: Die Desktop-GUI muss BME280-Sensordaten anzeigen und GPIO-Pins über die REST API setzen können.
STATUS: Active
REQUIREMENT_TYPE: functional
PRIORITY: Medium
RELATIONS:
