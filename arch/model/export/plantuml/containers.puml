@startuml
!include <C4/C4_Component>

System(bbcli, "bbcli", "Go 1.23 / Cobra + Viper", "Kommandozeilen-Tool für direkte API-Interaktion; Subcommands: bme280, gpio, backend, system, completion. Cross-compiled für Linux amd64/arm. Quelle: tools/cli/")
System(bbgui, "bbgui", "Go / Fyne v2", "Desktop-GUI Anwendung mit grafischer Darstellung der Sensordaten; Tabs für BME280, GPIO, UART, SPI, Backend, System. Quelle: tools/desktop-gui/main.go")
System(bbtui, "bbtui", "Go 1.24 / BubbleTea + Lipgloss", "Interaktives Terminal-UI für Echtzeit-Anzeige von Sensordaten; Tabs 1-6, automatischer BME280-Refresh alle 2s. Quelle: tools/tui/main.go")
Person(developer, "Entwickler / Operator", "Entwickelt, baut und deployt das System; überwacht Hardware-Sensoren")
System(webdashboard, "Web Dashboard", "HTML / Vanilla JavaScript / SSE", "Browser-basiertes Dashboard für Sensor-Visualisierung und GPIO-Steuerung via SSE-Stream. Quelle: tools/web-gui/")
System_Boundary(beaglebone, "BeagleBone Black Embedded SW") {
  System(beaglebone_c_lib, "C Hardware Library", "C / arm-linux-gnueabihf-gcc", "Cross-kompilierte Shared Library (libhardware.so). Quellen: c-lib/ (Makefile-Target: make c-lib). Kopiert nach project/go-api/libs/")
  Container(beaglebone_go_api, "REST API Server", "Go 1.23 / gorilla/mux", "HTTP-Server auf Port 5000; verarbeitet Anfragen und delegiert an HAL. Binary: bin/embedded. Quelle: project/go-api/")
  Component(beaglebone_hardware, "Hardware Interfaces", "BeagleBone Black / Linux Kernel Interfaces", "Physische Schnittstellen des TI AM335x Prozessors auf dem BeagleBone Black")
  System(beaglebone_rust_lib, "Rust Hardware Library", "Rust / armv7-unknown-linux-musleabihf (musl)", "Cross-kompilierte Shared Library (libhardware_rs.so). Memory-Safe Alternative zur C-Lib. Target: armv7-unknown-linux-musleabihf. Quelle: project/rust-lib/")
}

Rel(developer, bbcli, "bedient")
Rel(developer, bbtui, "bedient")
Rel(developer, bbgui, "bedient")
Rel(developer, webdashboard, "öffnet")
Rel(developer, beaglebone, "make deploy (SCP + systemctl)")
Rel(bbcli, beaglebone_go_api, "HTTP REST :5000")
Rel(bbtui, beaglebone_go_api, "HTTP REST :5000")
Rel(bbgui, beaglebone_go_api, "HTTP REST :5000")
Rel(webdashboard, beaglebone_go_api, "HTTP REST :5000")
Rel(beaglebone_go_api, beaglebone_c_lib, "CGO")
Rel(beaglebone_go_api, beaglebone_rust_lib, "FFI")
Rel(beaglebone_c_lib, beaglebone_hardware, "I2C ioctl read")
Rel(beaglebone_rust_lib, beaglebone_hardware, "I2C read (linux-embedded-hal)")
@enduml
